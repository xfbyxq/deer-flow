DEERFLOW_BASE_URL=http://127.0.0.1:2026
SERVICE_EMAIL=971762302@qq.com
SERVICE_PASSWORD=
MCP_HOST=0.0.0.0
MCP_PORT=8765
DATABASE_URL=sqlite+aiosqlite:///./waker_team.db

# CORS 可信来源白名单（CF10）。
# 格式要求：**必须是 JSON 数组字符串**（pydantic-settings 对 list[str] 的解析要求）。
# 禁止使用 "*"——与 allow_credentials=True 组合会把带凭据的跨域请求开放给任意来源。
# 留空/不设置则使用默认白名单：localhost 与 127.0.0.1 的 5173(vite dev)、
# 4173(vite preview)、3000(DeerFlow 前端 dev)、2026(nginx 入口)。
# 部署到自有域名时覆盖，例如：
#   CORS_ORIGINS='["https://your.origin"]'
# 多个来源：
#   CORS_ORIGINS='["https://a.example.com","https://b.example.com"]'
# 注意：不要写成裸 URL（CORS_ORIGINS=http://x）——虽会被容错包装，但推荐显式 JSON 数组。
CORS_ORIGINS=

# 唤醒 run 护栏（阈值为 per-process 语义：Gateway 与 MCP Server 各自独立计数，CF18）。
# wake_max_concurrency：后台投递 worker 池规模 = 同时在途 wake run 创建数上限。
# wake_max_per_minute：滑动窗口（60s）内允许投递的 wake run 数上限。
# wake_throttle_wait_timeout_seconds：触发限速后的最长等待（超时后重新入队延后重试）。
WAKE_MAX_CONCURRENCY=4
WAKE_MAX_PER_MINUTE=30
WAKE_THROTTLE_WAIT_TIMEOUT_SECONDS=60.0

# SyncEngine 瞬时错误（网关不可达/写锁等）的连续重试预算（轮数，CF2）。
# 默认 30 轮 ≈ 5min @10s interval；超阈后任务置 failed（"Sync error: upstream unreachable"）。
SYNC_MAX_TRANSIENT_FAILURES=30
