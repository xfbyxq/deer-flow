config_version: 40
log_level: info
token_usage:
  enabled: true
models:
- name: mimo-v2.5
  display_name: Xiaomi MiMo V2.5
  use: deerflow.models.patched_mimo:PatchedChatMiMo
  model: mimo-v2.5
  api_key: $MIMO_API_KEY
  base_url: https://token-plan-cn.xiaomimimo.com/v1
  request_timeout: 600.0
  max_retries: 2
  max_tokens: 8192
  temperature: 0.7
  supports_vision: true
  supports_thinking: true
  when_thinking_enabled:
    extra_body:
      thinking:
        type: enabled
  when_thinking_disabled:
    extra_body:
      thinking:
        type: disabled
tool_groups:
- name: web
- name: file:read
- name: file:write
- name: bash
- name: browser
- name: knowledge
tools:
- name: web_search
  group: web
  use: deerflow.community.ddg_search.tools:web_search_tool
  max_results: 5
- name: web_fetch
  group: web
  use: deerflow.community.jina_ai.tools:web_fetch_tool
  timeout: 10
- name: image_search
  group: web
  use: deerflow.community.image_search.tools:image_search_tool
  max_results: 5
- name: ls
  group: file:read
  use: deerflow.sandbox.tools:ls_tool
- name: read_file
  group: file:read
  use: deerflow.sandbox.tools:read_file_tool
- name: glob
  group: file:read
  use: deerflow.sandbox.tools:glob_tool
  max_results: 200
- name: grep
  group: file:read
  use: deerflow.sandbox.tools:grep_tool
  max_results: 100
- name: write_file
  group: file:write
  use: deerflow.sandbox.tools:write_file_tool
- name: str_replace
  group: file:write
  use: deerflow.sandbox.tools:str_replace_tool
- name: bash
  group: bash
  use: deerflow.sandbox.tools:bash_tool
tool_search:
  enabled: false
  auto_promote_top_k: 3
uploads:
  pdf_converter: auto
  max_files: 10
  max_file_size: 52428800
  max_total_size: 104857600
  auto_convert_documents: false
sandbox:
  use: deerflow.sandbox.local:LocalSandboxProvider
  allow_host_bash: false
  bash_output_max_chars: 20000
  read_file_output_max_chars: 50000
  ls_output_max_chars: 20000
  mounts: []
  bash_command_timeout: 600
skills:
  container_path: /mnt/skills
title:
  enabled: true
  max_words: 6
  max_chars: 60
  model_name: null
summarization:
  enabled: true
  model_name: null
  trigger:
  - type: tokens
    value: 32000
  keep:
    type: messages
    value: 10
  trim_tokens_to_summarize: 15564
  summary_prompt: null
  skill_file_read_tool_names:
  - read_file
  - read
  - view
  - cat
memory:
  enabled: true
  injection_enabled: true
  shutdown_flush_timeout_seconds: 30.0
  manager_class: deermem
  mode: middleware
  backend_config:
    storage_path: ''
    storage_class: file
    strict_user_scope: false
    manifest_filename: memory.json
    file_lock_timeout_seconds: 10
    retrieval_adapter: fts5
    debounce_seconds: 30
    queue_max_depth: 1000
    model: null
    max_facts: 100
    fact_confidence_threshold: 0.7
    max_injection_tokens: 2000
    token_counting: tiktoken
    guaranteed_categories:
    - correction
    guaranteed_token_budget: 500
    staleness_review_enabled: true
    staleness_age_days: 90
    staleness_min_candidates: 3
    staleness_max_removals_per_cycle: 10
    staleness_protected_categories:
    - correction
    staleness_max_lifetime_multiplier: 20.0
    staleness_max_extension_days: 3650
    consolidation_enabled: false
    consolidation_min_facts: 8
    consolidation_max_groups_per_cycle: 3
    consolidation_max_sources: 8
    fact_eviction_policy: confidence
    fact_eviction_shadow_enabled: false
    eviction_confidence_weight: 0.65
    eviction_confirmation_weight: 0.25
    eviction_access_weight: 0.1
    eviction_confirmation_half_life_days: 90
    eviction_access_half_life_days: 30
    eviction_correction_reserved_fraction: 0.1
    eviction_correction_reserved_max: 10
    eviction_audit_max_entries: 200
skill_evolution:
  enabled: false
  moderation_model_name: null
  security_fail_closed: true
agents_api:
  enabled: true
subagents:
  timeout_seconds: 1800
  custom_agents:
    data-collector:
      description: A股数据采集agent，使用akshare获取行情/财报/K线数据，通过qveris获取实时行情
      system_prompt: '你是一个A股数据采集专家。专注于：

        - 使用Python akshare库获取A股历史数据（K线、财报、龙虎榜、北向资金等）

        - 通过qveris-assistant技能获取实时行情和全球市场数据

        - 将数据保存为CSV/JSON文件供其他agent使用

        - 输出文件统一放在 /mnt/user-data/workspace/stock-data/ 目录

        重要规则：

        - 数据必须来自akshare API或qveris，不要编造任何数据

        - 如果akshare未安装，用 pip install akshare 安装

        - 也可使用 fetch_data.py 脚本：python {baseDir}/scripts/fetch_data.py <command> <args>

        - 每次获取数据后输出数据摘要（行数、字段、时间范围）

        '
      tools:
      - bash
      - write_file
      - read_file
      skills:
      - qveris-assistant
      model: inherit
      max_turns: 50
      timeout_seconds: 600
    market-analyst:
      description: A股市场宏观分析师，分析大盘趋势、板块轮动和政策面
      system_prompt: '你是一个专业的A股市场宏观分析师。专注于：

        - 分析上证指数、深证成指、创业板指趋势

        - 板块轮动和热点追踪

        - 宏观经济政策对市场的影响

        - 北向资金流向、融资融券数据解读

        - 市场情绪和成交量分析

        分析方法：

        1. 先读取 data-collector 提供的数据文件

        2. 结合 web_search 搜索最新政策和市场新闻

        3. 通过 qveris-assistant 获取实时市场数据

        4. 输出结构化的市场分析结论

        '
      tools:
      - web_search
      - web_fetch
      - read_file
      - bash
      skills:
      - deep-research
      - qveris-assistant
      model: inherit
      max_turns: 80
      timeout_seconds: 900
    stock-researcher:
      description: A股个股深度研究员，分析个股基本面、技术面和资金面
      system_prompt: '你是一个专业的A股个股研究员。专注于：

        - 基本面分析：财务报表、估值指标(PE/PB/ROE)、盈利能力、成长性

        - 技术面分析：K线形态、均线系统、MACD/KDJ指标、支撑阻力位

        - 资金面分析：主力资金流向、龙虎榜、机构持仓变动

        - 行业对比分析

        分析方法：

        1. 先读取 data-collector 提供的数据文件

        2. 结合 web_search 搜索个股最新公告、研报、新闻

        3. 通过 qveris-assistant 获取实时个股数据

        4. 输出结构化的个股研究报告

        重要规则：

        - 明确标注数据来源和时间

        - 区分事实和观点

        - 风险提示必须包含

        '
      tools:
      - web_search
      - web_fetch
      - read_file
      - bash
      skills:
      - deep-research
      - data-analysis
      - qveris-assistant
      model: inherit
      max_turns: 100
      timeout_seconds: 900
    report-writer:
      description: 投资研究报告撰写agent，整合分析结果输出专业Markdown研报
      system_prompt: '你是一个专业的投资研究报告撰写专家。专注于：

        - 整合 market-analyst 和 stock-researcher 的分析结果

        - 按照券商研报标准格式输出Markdown报告

        - 生成可视化图表支撑论点

        - 确保数据引用准确、逻辑清晰

        研报结构：

        1. 核心观点（200字以内）

        2. 市场环境分析

        3. 个股/行业分析

        4. 技术面分析

        5. 风险提示

        6. 投资建议（仅供参考）

        重要规则：

        - 所有数据必须来自其他agent的分析结果，不编造数据

        - 风险提示必须醒目

        - 报告末尾附加免责声明

        '
      tools:
      - read_file
      - write_file
      - bash
      skills:
      - consulting-analysis
      - chart-visualization
      model: inherit
      max_turns: 80
      timeout_seconds: 600
channels:
  langgraph_url: http://localhost:8001/api
  gateway_url: http://localhost:8001
  session:
    assistant_id: lead_agent
    config:
      recursion_limit: 100
    context:
      thinking_enabled: true
      is_plan_mode: false
      subagent_enabled: false
  feishu:
    enabled: true
    app_id: $FEISHU_APP_ID
    app_secret: $FEISHU_APP_SECRET
loop_detection:
  enabled: true
  warn_threshold: 3
  hard_limit: 5
  window_size: 20
  max_tracked_threads: 100
  tool_freq_warn: 30
  tool_freq_hard_limit: 50
database:
  backend: sqlite
  sqlite_dir: .deer-flow/data
  pool_recycle: 300
  command_timeout: 30
  checkpoint_channel_mode: full
  checkpoint_delta:
    snapshot_frequency: 10
  checkpoint_graph_cache:
    accessor_graph_max: 64
run_events:
  backend: memory
  max_trace_content: 10240
  track_token_usage: true
logging:
  enhance:
    enabled: false
    format: text
token_budget:
  enabled: false
  max_tokens: 200000
  max_input_tokens: null
  max_output_tokens: null
  warn_threshold: 0.8
  hard_stop_threshold: 1.0
max_recursion_limit: 1000
tool_output:
  enabled: true
  externalize_min_chars: 12000
  preview_head_chars: 2000
  preview_tail_chars: 1000
  fallback_max_chars: 30000
  fallback_head_chars: 8000
  fallback_tail_chars: 3000
  storage_subdir: .tool-results
  exempt_tools:
  - read_file
  - read_file_tool
suggestions:
  enabled: true
  max_suggestions: 3
read_before_write:
  enabled: true
safety_finish_reason:
  enabled: true
scheduler:
  enabled: false
  poll_interval_seconds: 5
  lease_seconds: 120
  max_concurrent_runs: 3
  min_once_delay_seconds: 60
  multi_instance: false
  queue_timeout_seconds: 3600
  recursion_limit: 1000
input_polish:
  enabled: true
  max_chars: 4000
  model_name: null
skill_scan:
  enabled: true
agent_storage:
  backend: file
mcp_tasks:
  enabled: false
  poll_interval_seconds: 5
  lease_seconds: 120
  max_concurrent_polls: 8
  max_poll_backoff_seconds: 300
  input_required_poll_interval_seconds: 60
  tracking_degraded_after_errors: 3
  max_result_bytes: 65536
  result_preview_max_chars: 2000
run_ownership:
  lease_seconds: 30
  grace_seconds: 10
  heartbeat_enabled: false
authorization:
  enabled: false
subagent_runtime:
  max_running: 3
  max_queued: 64
  admission_policy: queue
  queue_timeout_seconds: 300
subagent_batches:
  enabled: false
  poll_interval_seconds: 1
  lease_seconds: 120
  max_items_per_batch: 5000
  default_max_live_items: 100
  max_live_items_per_batch: 1000
  default_max_running_items: 3
  max_running_items_per_batch: 64
  max_attempts: 3
  max_result_chars: 100000
  result_preview_max_chars: 2000
verification:
  receipts_enabled: true
  receipts_render_mode: delegation_only
  judge_enabled: false
  judge_model_name: null
